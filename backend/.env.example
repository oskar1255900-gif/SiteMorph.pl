[TEMPLATE]
OPENROUTER_API_KEY=
# Jedyny model generatora. Wartosc jest zablokowana w kodzie - inna zostanie zignorowana.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# HTTP-Referer wysylany do OpenRouter (nazwa zmiennej jest historyczna).
OPENROUTER_SITE_URL=https://sitemorph.pl
OPENROUTER_APP_NAME=SiteMorph
ADMIN_HASH=sha256_hasla_admina
GOOGLE_PLACES_API_KEY=AIza...
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://xxx.supabase.co/auth/v1/.well-known/jwks.json
# Odkomentuj po skopiowaniu DOKLADNEGO URI z Supabase -> Database -> Connection string -> Transaction pooler
# DATABASE_URL=postgresql://postgres.xxx:HASLO@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Generator: JEDEN model, JEDEN request, bez fallbacku ---
# Model jest zablokowany w kodzie. Nie ma listy modeli ani automatycznego routera.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SITEMORPH_MAX_OUTPUT_TOKENS=32000
# Limit czasu jedynego wywolania modelu.
SITEMORPH_OPENROUTER_CONNECT_TIMEOUT=8
SITEMORPH_OPENROUTER_TIMEOUT=55
SITEMORPH_OPENROUTER_REASONING_PARAM=1
# Nemotron 3 Super obsluguje structured output (json_schema).
SITEMORPH_OPENROUTER_JSON_FORMAT=1
# Legacy (nieuzywane przez /api/builder/generate, tylko stare helpery debugowe):
# XKIRO_API_KEY=
# XKIRO_BASE_URL=https://api.xkiro.com/v1
# GEMINI_API_KEY=
# GEMINI_BASE_URL=
# SITEMORPH_DEEPSEEK_MODEL=deepseek/deepseek-v3.2
# Opcjonalne zdjęcia stock. Bez klucza użyj własnych zdjęć.
UNSPLASH_ACCESS_KEY=
# Timeout to limit oczekiwania, nie obietnica czasu generowania.
# SITEMORPH_AI_TIMEOUT=280

# --- Wlasne domeny klientow ---
# CNAME: klient u rejestratora ustawia www -> ta domena (host, ktory wskazuje na Twoj serwer)
CUSTOM_DOMAIN_TARGET_CNAME=sites.sitemorph.pl
# Rekord A dla apexu (@): publiczne IP Twojego serwera. Puste = pokazujemy tylko instrukcje CNAME.
CUSTOM_DOMAIN_TARGET_IP=
# Hosty samej aplikacji SiteMorph (poza nimi kazdy Host traktowany jako domena klienta)
APP_DOMAINS=sitemorph.pl,www.sitemorph.pl
# Origin-y dozwolone w CORS (rozdzielone przecinkiem)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Bramka "strona w budowie" - wystarczy JEDEN sposob:
PANEL_PASSWORD=twoje-haslo-wprost
# GATE_HASH=<sha256-hasla>
# (jesli brak obu, uzyty jest ADMIN_HASH)
