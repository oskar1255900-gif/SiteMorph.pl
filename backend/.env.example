OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=SiteMorph
ADMIN_HASH=sha256_hasla_admina
GOOGLE_PLACES_API_KEY=AIza...
GEMINI_API_KEY=AQ.Ab8...
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://xxx.supabase.co/auth/v1/.well-known/jwks.json
# Odkomentuj po skopiowaniu DOKLADNEGO URI z Supabase -> Database -> Connection string -> Transaction pooler
# DATABASE_URL=postgresql://postgres.xxx:HASLO@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Wlasne domeny klientow ---
# CNAME: klient u rejestratora ustawia www -> ta domena (host, ktory wskazuje na Twoj serwer)
CUSTOM_DOMAIN_TARGET_CNAME=sites.sitemorph.pl
# Rekord A dla apexu (@): publiczne IP Twojego serwera. Puste = pokazujemy tylko instrukcje CNAME.
CUSTOM_DOMAIN_TARGET_IP=
# Hosty samej aplikacji SiteMorph (poza nimi kazdy Host traktowany jako domena klienta)
APP_DOMAINS=sitemorph.pl,www.sitemorph.pl
# Origin-y dozwolone w CORS (rozdzielone przecinkiem)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

